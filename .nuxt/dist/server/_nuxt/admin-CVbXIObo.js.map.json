{"file":"admin-CVbXIObo.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AAeA,UAAM,YAAY,IAAI,IAAI;;;;;;;;;;;;;;;;;;;;;","names":[],"sources":["../../../../layouts/admin.vue"],"sourcesContent":["<template>\n  <div class=\"admin-layout\">\n    <div v-if=\"isLoading\" class=\"loading-container\">\n      <div class=\"loading-spinner\"></div>\n      <p>載入中...</p>\n    </div>\n    <div v-else>\n      <slot />\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue';\n\nconst isLoading = ref(true);\n\nonMounted(() => {\n  // 給一個短暫的延遲確保樣式都載入完成\n  setTimeout(() => {\n    isLoading.value = false;\n  }, 100);\n});\n</script>\n\n<style lang=\"scss\" scoped>\n.admin-layout {\n  min-height: 100vh;\n  background-color: #f8f9fa;\n}\n\n/* Loading 樣式 */\n.loading-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  background-color: #f8f9fa;\n}\n\n.loading-spinner {\n  width: 40px;\n  height: 40px;\n  border: 3px solid #f3f3f3;\n  border-top: 3px solid #41BBBE;\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n.loading-container p {\n  margin-top: 1rem;\n  color: #41BBBE;\n  font-size: 14px;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n</style> "],"version":3}