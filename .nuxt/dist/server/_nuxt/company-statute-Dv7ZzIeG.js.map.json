{"file":"company-statute-Dv7ZzIeG.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AAyBW,eAAA,EAAE,OAAO,sBAAsB;;;;;;;;;;;;;;;;;;;;;;;;;;;","names":[],"sources":["../../../../pages/company-statute.vue"],"sourcesContent":["<template>\n  <div class=\"main-container company-statute\">\n    <h2 class=\"default-title company-title\">多元陪伴照顧服務法規</h2>\n    <div class=\"comapny-statute-list\">\n      <div class=\"comapny-statute-list-item\">\n        <div class=\"item-number\">01</div>\n        <div class=\"item-desc\"><Nuxt-link href=\"/conduct-plan\">多元陪伴照顧服務試辦計畫</Nuxt-link></div>\n      </div>\n      <div class=\"comapny-statute-list-item\">\n        <div class=\"item-number\">02</div>\n        <div class=\"item-desc\"><a href=\"https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=N0090001\" target=\"_blank\">就業服務法</a></div>\n      </div>\n      <div class=\"comapny-statute-list-item\">\n        <div class=\"item-number\">03</div>\n        <div class=\"item-desc\"><a href=\"https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=N0090029\" target=\"_blank\">外國人從事就業服務法第四十六條第一項第八款至第十一款工作資格及審查標準(藍領審查標準)</a></div>\n      </div>\n      <div class=\"comapny-statute-list-item\">\n        <div class=\"item-number\">04</div>\n        <div class=\"item-desc\"><a href=\"https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=N0090023\" target=\"_blank\">外國人受聘僱從事就業服務法第四十六條第一項第八款至第十一款規定工作之轉換雇主或工作程序準則(外國人轉換準則)</a></div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nuseSeoMeta({ title: \"多元陪伴法規｜ 多元陪伴照顧服務計畫\" });\n</script>\n\n<style scoped>\n  .company-title {\n    margin-top: 80px;\n    margin-bottom: 80px;\n  }\n  .comapny-statute-list {\n    padding-left: 40px;\n    margin-bottom: 100px;\n  }\n  .comapny-statute-list-item {\n    display: flex;\n    align-items: center;\n    gap: 50px;\n    margin-bottom: 30px;\n  }\n  .comapny-statute-list-item .item-number {\n    font-size: 67px;\n    font-weight: bold;\n    color: #EC6717;\n    flex: 0 0 80px;\n  }\n  .comapny-statute-list-