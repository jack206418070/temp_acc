{"file":"admin-DwaKDpgj.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AAeA,UAAM,YAAY,IAAI,IAAI;;;;;;;;;;;;;;;;;;;;;","names":[],"sources":["../../../../layouts/admin.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-layout\">\r\n    <div v-if=\"isLoading\" class=\"loading-container\">\r\n      <div class=\"loading-spinner\"></div>\r\n      <p>載入中...</p>\r\n    </div>\r\n    <div v-else>\r\n      <slot />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from 'vue';\r\n\r\nconst isLoading = ref(true);\r\n\r\nonMounted(() => {\r\n  // 給一個短暫的延遲確保樣式都載入完成\r\n  setTimeout(() => {\r\n    isLoading.value = false;\r\n  }, 100);\r\n});\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.admin-layout {\r\n  min-height: 100vh;\r\n  background-color: #f8f9fa;\r\n}\r\n\r\n/* Loading 樣式 */\r\n.loading-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 100vh;\r\n  background-color: #f8f9fa;\r\n}\r\n\r\n.loading-spinner {\r\n  width: 40px;\r\n  height: 40px;\r\n  border: 3px solid #f3f3f3;\r\n  border-top: 3px solid #41BBBE;\r\n  border-radius: 50%;\r\n  animation: spin 1s linear infinite;\r\n}\r\n\r\n.loading-container p {\r\n  margin-top: 1rem;\r\n  color: #41BBBE;\r\n  font-size: 14px;\r\n}\r\n\r\n@keyframes spin {\r\n  0% { transform: rotate(0deg); }\r\n  100% { transform: rotate(360deg); }\r\n}\r\n</style> "],"version":3}